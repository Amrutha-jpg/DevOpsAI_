# ==========================================
# DevOpsAI Production Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------
DB_URL=jdbc:postgresql://db:5432/devopsai
DB_USERNAME=devopsai_user
DB_PASSWORD=devopsai_secure_password_change_me_123

# ------------------------------------------
# 2. Security & Authentication (JWT)
# ------------------------------------------
# Minimum 256-bit secure key (HS256 requires >= 32 bytes / 64 hex chars)
JWT_SECRET=9a6f8b12c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1
JWT_EXPIRATION_MS=86400000

# ------------------------------------------
# 3. AI / LLM Integrations
# ------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# ------------------------------------------
# 4. GitHub Integration & Webhooks
# ------------------------------------------
GITHUB_CLIENT_ID=ov23-your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret-here
GITHUB_WEBHOOK_SECRET=whsec_your-github-webhook-secret-here

# ------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------
# Comma-separated list of allowed production domain origins (or * for all)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://app.devopsai.com
